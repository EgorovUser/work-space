# Скопируйте этот файл в .env и заполните свои значения.
# В режиме APP_ENV=prod без SECRET_KEY и FERNET_KEY процесс не запустится.
#
# Приложение рассчитано на работу по обычному HTTP без домена
# (например, http://IP:8088). Secure-cookie не используются.

APP_ENV=prod

# Длинная случайная строка. Генерация:
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-long-random-string

# Ключ Fernet (шифрование секретов, паролей ящика и SMTP).
# Генерация:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ВНИМАНИЕ: при потере этого ключа старые зашифрованные данные невозможно восстановить.
FERNET_KEY=replace-with-fernet-key

# Опционально: старый ключ для ротации.
# При запуске с новым FERNET_KEY поставьте сюда предыдущий.
# Шифрование идёт новым, расшифровка — любым. При сохранении запись перешифровывается.
# После того как все записи пересохранены хотя бы раз — можно убрать.
FERNET_KEY_OLD=

# Каталог данных (база, файлы, логи). В Docker это обычно ./data
DATA_DIR=./data

# Пусто — будет sqlite:///DATA_DIR/app.db
DATABASE_URL=

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Первый пользователь создаётся только если в базе ещё никого нет.
# После этого смена этих строк на уже существующего пользователя не влияет.
SEED_USERNAME=admin
SEED_PASSWORD=replace-with-strong-password
